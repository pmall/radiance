            Repeat(from: (28.0, 0.0, 24.0), step: (8.0, 0.0, 0.0), count: 12, parts: [
                Slot(at: (0.0, 0.0, 0.0), pick: [Some("girder_stub"), Some("girder_stub"), None]),
            ]),
            Slot(at: (40.0, 0.0, 19.0), pick: [Some("beam_stack"), Some("block_pallet"), None]),
            Slot(at: (88.0, 0.0, 19.0), pick: [Some("block_pallet"), Some("site_cabin"), None]),
            Slot(at: (12.0, 0.0, 12.0), pick: [Some("tower_crane"), None, None, None]),
