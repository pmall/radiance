    name: "unbuilt",
    size: (6, 6),
    zones: [Canopy],
    labels: ["hole", "construction"],
    weight: 6,
    holes: [((1, 1), (5, 5))],
    towers_rise: true,
    parts: [
        Mirror4(center: (72.0, 72.0), parts: [
            Repeat(from: (25.0, 0.0, 23.6), step: (6.0, 0.0, 0.0), count: 16, parts: [
