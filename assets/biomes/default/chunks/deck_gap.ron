// Hole: a gap one lot wide and two long, where a slab was never laid. Railings along its rims; a
// footbridge across the middle (or railings where it would have landed), lamps at its ends, a
// bench facing the void. Below, the floor beneath catches the light.
Chunk(
    name: "deck_gap",
    size: (3, 4),
    zones: [Depths, Middle],
    labels: ["hole"],
    weight: 4,
    holes: [((1, 1), (2, 3))],
    towers_rise: true,
    parts: [
        // The long rims (x = 24 and, mirrored, x = 48), open from z = 44 to 52 for the bridge.
        Mirror2(axis: X, at: 36.0, parts: [
            Repeat(from: (24.0, 0.0, 28.0), step: (0.0, 0.0, 4.0), count: 5, parts: [
                Module(name: "railing", turn: 1),
            ]),
            Repeat(from: (24.0, 0.0, 56.0), step: (0.0, 0.0, 4.0), count: 5, parts: [
                Module(name: "railing", turn: 1),
            ]),
            Slot(at: (21.5, 0.0, 43.0), pick: [Some("lamp"), None]),
            Slot(at: (21.0, 0.0, 60.0), turn: 1, pick: [Some("bench"), Some("planter"), None]),
        ]),
        // The short rims (z = 24 and, mirrored, z = 72).
        Mirror2(axis: Z, at: 48.0, parts: [
            Repeat(from: (24.0, 0.0, 24.0), step: (4.0, 0.0, 0.0), count: 6, parts: [
                Module(name: "railing"),
            ]),
            Slot(at: (36.0, 0.0, 21.5), pick: [Some("sign_danger"), None, None]),
        ]),
        Slot(at: (24.0, 0.0, 48.0), pick: [Some("footbridge_span"), Some("footbridge_span"),
            Some("gap_closed")]),
    ],
)
