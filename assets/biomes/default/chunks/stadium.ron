// Area: a stadium of the middle floors, eight lots by eight: a pitch gone to seed, ten tiers
// of seats on every side under roofs on the long ones, floodlight masts at the corners, a dark
// scoreboard at one end, kiosks outside.
Chunk(
    name: "stadium",
    size: (8, 8),
    zones: [Middle],
    labels: ["stadium"],
    weight: 2,
    spacing: 40,
    ground: Some(Concrete),
    parts: [
        // The pitch, its grass gone to seed (soil would grow six times denser, too much here).
        Box(at: (46.0, 0.0, 66.0), size: (100.0, 0.15, 60.0), mat: Paint((76, 104, 62))),
        Box(at: (95.8, 0.15, 66.0), size: (0.4, 0.01, 60.0), mat: Paint((200, 200, 190))),
        Mirror2(axis: Z, at: 96.0, parts: [
            Repeat(from: (42.0, 0.0, 62.0), step: (12.0, 0.0, 0.0), count: 9, parts: [
                Module(name: "stand_bay", accent: (150, 50, 44)),
                Module(name: "stand_roof"),
            ]),
        ]),
        Mirror2(axis: X, at: 96.0, parts: [
            Repeat(from: (42.0, 0.0, 78.0), step: (0.0, 0.0, 12.0), count: 5, parts: [
                Module(name: "stand_bay", turn: 1, accent: (52, 96, 140)),
            ]),
            Mirror2(axis: Z, at: 96.0, parts: [
                Module(name: "floodlight", at: (34.0, 0.0, 56.0)),
                Module(name: "kiosk", at: (24.0, 0.0, 36.0), turn: 2),
                Slot(at: (14.0, 0.0, 46.0), rate: Props, pick: [Some("bin"), Some("wall_trash"), None]),
            ]),
        ]),
        Module(name: "scoreboard", at: (22.0, 0.0, 96.0), turn: 1, accent: (200, 160, 40)),
        Slot(at: (96.0, 0.15, 96.0), rate: Poi, pick: [Some("poi_armchair")]),
    ],
)
