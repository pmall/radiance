// Area: a railway station, six lots by six: a train shed of stepped steel arches over three
// platforms and four tracks, the head building on the forecourt side with its clock tower, a
// forecourt of shelters, benches and tree beds, a freight yard behind. The trains never came back.
Chunk(
    name: "station",
    size: (6, 6),
    zones: [Depths, Middle],
    labels: ["station"],
    weight: 2,
    spacing: 40,
    ground: Some(Concrete),
    parts: [
        Repeat(from: (12.0, 0.0, 60.0), step: (12.0, 0.0, 0.0), count: 10, parts: [
            Module(name: "shed_bay"),
        ]),
        Repeat(from: (12.0, 0.0, 48.0), step: (12.0, 0.0, 0.0), count: 10, parts: [
            Module(name: "platform_bay"),
            Module(name: "platform_bay", at: (0.0, 0.0, 12.0)),
            Module(name: "platform_bay", at: (0.0, 0.0, 24.0)),
        ]),
        Repeat(from: (0.0, 0.0, 42.0), step: (24.0, 0.0, 0.0), count: 6, parts: [
            Module(name: "tram_rails"),
            Module(name: "tram_rails", at: (0.0, 0.0, 12.0)),
            Module(name: "tram_rails", at: (0.0, 0.0, 24.0)),
            Module(name: "tram_rails", at: (0.0, 0.0, 36.0)),
        ]),
        // The head building, its hall open in the middle under the clock.
        Box(at: (16.0, 0.0, 84.0), size: (48.0, 16.0, 18.0), mat: Brick),
        Box(at: (80.0, 0.0, 84.0), size: (48.0, 16.0, 18.0), mat: Brick),
        Box(at: (64.0, 8.0, 84.0), size: (16.0, 8.0, 18.0), mat: Brick),
        Box(at: (15.5, 16.0, 83.5), size: (113.0, 1.0, 19.0), mat: Stone),
        Box(at: (15.5, 0.0, 101.6), size: (113.0, 0.8, 0.6), mat: StoneDark),
        Repeat(from: (20.0, 4.0, 102.0), step: (6.0, 0.0, 0.0), count: 8, parts: [
            Module(name: "window"),
            Module(name: "window", at: (0.0, 5.0, 0.0)),
        ]),
        Repeat(from: (84.0, 4.0, 102.0), step: (6.0, 0.0, 0.0), count: 8, parts: [
            Module(name: "window"),
            Module(name: "window", at: (0.0, 5.0, 0.0)),
        ]),
        Module(name: "clock_tower", at: (72.0, 0.0, 108.0)),
        // The forecourt.
        Mirror2(axis: X, at: 72.0, parts: [
            Module(name: "bus_shelter", at: (40.0, 0.0, 122.0), turn: 2),
            Module(name: "bus_shelter", at: (52.0, 0.0, 122.0), turn: 2),
            Module(name: "tree_bed", at: (20.0, 0.0, 128.0)),
            Growth(area: ((18.0, 126.0), (22.0, 130.0)), kind: Soil),
            Module(name: "bench", at: (28.0, 0.0, 112.0), turn: 2),
            Module(name: "lamp", at: (60.0, 0.0, 114.0), turn: 2),
            Slot(at: (30.0, 0.0, 136.0), pick: [Some("kiosk"), Some("stall"), None]),
        ]),
        // The freight yard.
        Repeat(from: (16.0, 0.0, 12.0), step: (14.0, 0.0, 0.0), count: 8, parts: [
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("crate_stack"), Some("beam_stack"), Some("block_pallet"), None]),
            Slot(at: (0.0, 0.0, 14.0), pick: [Some("crate_stack"), Some("wall_barrels"), None, None]),
        ]),
        Slot(at: (36.0, 1.0, 72.0), rate: Poi, pick: [Some("poi_bench")]),
    ],
)
