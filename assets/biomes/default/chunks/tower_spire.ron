// Tower: a spire of the construction front over two by two lots, the machines' tallest work. It
// rises 180 to 300 m over the top deck, stepping in three times: a base of glass and blank
// service columns, 36 x 36 m; a glass shaft; a slim top banded in color; and on it the frame
// still going up, a crane on top. Met rarely; seen from a kilometer away (`world::skyline`).
Chunk(
    name: "tower_spire",
    size: (2, 2),
    labels: ["tower", "landmark", "construction"],
    weight: 1,
    tower: (
        heights: [Front],
        rise: (180.0, 300.0),
        tiers: [
            (
                at: (6.0, 6.0),
                size: (36.0, 36.0),
                facade: (
                    front: [
                        "g  g  g  -1 v  -1 g  G  g",
                        "g  g  g  -1 v  -1 g  g  g",
                        "-2 -2 -2 -2 -2 -2 -2 -2 -2",
                        "g  G  g  -1 v  -1 g  g  g",
                        "g  g  g  -1 v  -1 g  g  G",
                        "g  g  g  -1 v  -1 g  g  g",
                        "G  g  g  -1 v  -1 g  g  g",
                        "g  g  g  -1 v  -1 g  g  g",
                        "H  H  H  -  h  -  H  H  H",
                    ],
                    side: [
                        "g  g  G  -1 v  -1 g  g  g",
                        "g  g  g  -1 v  -1 g  g  g",
                        "-2 -2 -2 -2 -2 -2 -2 -2 -2",
                        "g  g  g  -1 v  -1 G  g  g",
                        "g  g  g  -1 v  -1 g  g  g",
                        "g  G  g  -1 v  -1 g  g  g",
                        "g  g  g  -1 v  -1 g  g  G",
                        "g  g  g  -1 v  -1 g  g  g",
                        "H  H  -  -  h  -  -  H  H",
                    ],
                ),
                each_floor: [
                    Slot(at: (24.0, 0.0, 6.0), turn: 2, pick: [Some("vertical_sign"), None],
                        accents: [(176, 52, 44), (60, 120, 150), (220, 180, 60)]),
                    Slot(at: (24.0, 0.0, 42.0), turn: 0, pick: [Some("vertical_sign"), None],
                        accents: [(176, 52, 44), (60, 120, 150), (220, 180, 60)]),
                ],
                streets: [
                    Slot(at: (14.0, 0.0, 6.0), turn: 2, rate: Props, pick: [Some("wall_terrace"), None]),
                    Slot(at: (34.0, 0.0, 6.0), turn: 2, rate: Props, pick: [Some("wall_cabinet"), None]),
                    Slot(at: (6.0, 0.0, 24.0), turn: 3, rate: Props, pick: [Some("wall_leftovers")]),
                    Slot(at: (42.0, 0.0, 24.0), turn: 1, rate: Props, pick: [Some("wall_leftovers")]),
                    Slot(at: (24.0, 0.0, 42.0), turn: 0, rate: Props, pick: [Some("wall_leftovers")]),
                ],
                roof: [
                    Slot(at: (8.5, 0.0, 8.5), pick: [Some("roof_plant"), Some("roof_solar")]),
                    Slot(at: (39.5, 0.0, 39.5), pick: [Some("roof_plant"), Some("roof_pipes")]),
                ],
            ),
            // The glass shaft.
            (
                at: (10.0, 10.0),
                size: (28.0, 28.0),
                stories: (14, 24),
                facade: (
                    front: ["g2 g2 G2 v  g2 g2 g2", "g2 g2 g2 v  g2 g2 g2", "g2 g2 g2 v  g2 G2 g2", "-3 -3 -3 -3 -3 -3 -3"],
                    side: ["g2 g2 g2 v  g2 g2 g2", "G2 g2 g2 v  g2 g2 g2", "g2 g2 g2 v  g2 g2 g2", "-3 -3 -3 -3 -3 -3 -3"],
                ),
            ),
            // The slim top, banded in color.
            (
                at: (14.0, 14.0),
                size: (20.0, 20.0),
                stories: (14, 26),
                facade: (
                    front: ["-4 g  g  g  -4", "-4 g  G  g  -4", "-4 g  g  g  -4", "-1 -1 -1 -1 -1"],
                    side: ["-4 g  g  g  -4", "-4 G  g  g  -4", "-4 g  g  g  -4", "-1 -1 -1 -1 -1"],
                ),
            ),
            // The frame still going up: columns on a grid, a slab at every story, the crane.
            (
                at: (18.0, 18.0),
                size: (12.0, 12.0),
                stories: (4, 9),
                each_story: [
                    Repeat(from: (18.0, 0.0, 18.0), step: (3.85, 0.0, 0.0), count: 4, parts: [
                        Repeat(step: (0.0, 0.0, 3.85), count: 4, parts: [
                            Box(at: (0.0, 0.0, 0.0), size: (0.45, 3.65, 0.45), mat: Concrete),
                        ]),
                    ]),
                    Box(at: (18.0, 3.65, 18.0), size: (12.0, 0.35, 12.0), mat: Concrete),
                ],
                roof: [
                    Module(name: "tower_crane", at: (24.0, 0.0, 24.0)),
                    Module(name: "beam_stack", at: (20.0, 0.0, 27.0)),
                ],
            ),
        ],
    ),
)
