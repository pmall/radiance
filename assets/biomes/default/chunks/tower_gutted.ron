                    Box(at: (4.0, 0.0, 17.6), size: (9.0, 0.9, 0.4), mat: Concrete),
                    Box(at: (4.0, 0.0, 6.4), size: (0.4, 0.9, 11.2), mat: Concrete),
                    Slot(at: (12.0, 0.0, 12.0), pick: [Some("stair_housing"), None]),
