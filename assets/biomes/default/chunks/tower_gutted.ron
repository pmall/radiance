                        "v  x  k",
                        "k  k  k",
                        "k  k  k",
                        "v  k  x",
                        "v  x  x",
                        "v  k  w",
                        "v  x  k",
                        "-  S  S",
                    ],
                ),
                each_floor: [
                    Slot(at: (4.0, 0.0, 8.0), turn: 3, pick: [Some("fire_escape"), None]),
                ],
                streets: [
                    Slot(at: (12.0, 0.0, 5.0), turn: 2, pick: [Some("rubble"), Some("vacant_debris")]),
                    Slot(at: (12.0, 0.0, 19.0), turn: 0, pick: [Some("rubble"), None]),
                    Slot(at: (4.0, 0.0, 13.0), turn: 3, rate: Props, pick: [Some("wall_leftovers")]),
