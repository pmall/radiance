// Tower: an abandoned slab, 16 x 12 m, given up long before the rest: its windows broken or
// boarded floor after floor, a gaping band of empty bays where a fire went through, the shops
// shuttered, rubble at its foot. Old or standing in the stack, never at the construction front.
Chunk(
    name: "tower_gutted",
    size: (1, 1),
    labels: ["tower", "landmark"],
    weight: 1,
    tower: (
        heights: [Old, Stack],
        tiers: [
            (
                at: (4.0, 6.0),
                size: (16.0, 12.0),
                facade: (
                    front: [
                        "k  x  k  w",
                        "x  k  k  x",
                        "k  k  k  k",
                        "k  k  k  k",
                        "w  x  k  x",
                        "x  x  w  k",
                        "k  w  x  x",
                        "x  k  x  k",
                        "S  S  S  S",
                    ],
                    side: [
