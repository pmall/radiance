// Block: a light well, one lot open through its floor and every floor above, so daylight falls to
// the floor below. Railings all around its rim, lamps at the corners, benches and planters facing
// the void, a sign warning of the drop. Written as one side, turned four times.
Chunk(
    name: "light_well",
    size: (3, 3),
    labels: ["light_well"],
    weight: 3,
    holes: [((1, 1), (2, 2))],
    parts: [
        Growth(area: ((20.0, 20.0), (52.0, 52.0)), kind: Bare),
        Mirror4(center: (36.0, 36.0), parts: [
            // The rim: railings along the lot's edge (their outer face on it), on the lot before.
            Repeat(from: (24.0, 0.0, 24.0), step: (4.0, 0.0, 0.0), count: 6, parts: [
                Module(name: "railing", at: (0.0, 0.0, 0.0)),
            ]),
            Module(name: "lamp", at: (23.0, 0.0, 22.5), turn: 2),
            Module(name: "bench", at: (32.0, 0.0, 21.0)),
            Module(name: "bench", at: (40.0, 0.0, 21.0)),
            Slot(at: (36.0, 0.0, 21.0), pick: [Some("planter"), Some("bin"), None]),
            Slot(at: (28.0, 0.0, 20.5), pick: [Some("planter"), None]),
            Slot(at: (44.0, 0.0, 20.5), pick: [Some("planter"), Some("sign_danger"), None]),
        ]),
    ],
)
