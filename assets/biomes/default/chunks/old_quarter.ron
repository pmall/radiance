// Area: the old stone city of the depths, eight lots by eight, built before the first deck: a
// temple on its plaza at the heart, two avenues crossing there with their tram lines, arcaded
// stone buildings along them, and in each quarter narrow houses around a small square with a
// fountain, a bandstand or a pergola. Paved in dark setts.
Chunk(
    name: "old_quarter",
    size: (8, 8),
    zones: [Depths],
    labels: ["old_town"],
    weight: 3,
    spacing: 40,
    ground: Some(StoneDark),
    parts: [
        Module(name: "temple", at: (96.0, 0.0, 96.0)),
        Growth(area: ((84.0, 104.0), (108.0, 114.0)), kind: Bare),
        Mirror2(axis: X, at: 96.0, parts: [
            Mirror2(axis: Z, at: 96.0, parts: [
                // Arcades along both avenues, fronts on them.
                Repeat(from: (6.0, 0.0, 70.0), step: (12.0, 0.0, 0.0), count: 5, parts: [
                    Module(name: "arcade_bay"),
                ]),
                Repeat(from: (70.0, 0.0, 18.0), step: (0.0, 0.0, 12.0), count: 5, parts: [
                    Module(name: "arcade_bay", turn: 1),
                ]),
                // The tram lines and their poles.
                Repeat(from: (0.0, 0.0, 93.5), step: (24.0, 0.0, 0.0), count: 3, parts: [
                    Module(name: "tram_rails"),
                ]),
                Repeat(from: (93.5, 0.0, 24.0), step: (0.0, 0.0, 24.0), count: 3, parts: [
                    Module(name: "tram_rails", turn: 1),
                ]),
                Repeat(from: (1.0, 0.0, 90.6), step: (24.0, 0.0, 0.0), count: 3, parts: [
                    Module(name: "tram_pole"),
                ]),
                // The plaza around the temple.
                Module(name: "lamp", at: (76.0, 0.0, 76.0), turn: 0),
                Module(name: "bench", at: (84.0, 0.0, 74.0)),
                Slot(at: (78.0, 0.0, 86.0), pick: [Some("planter"), Some("tree_bed"), None]),
                // A quarter: houses along its outer streets and around its small square.
                Repeat(from: (9.0, 0.0, 6.0), step: (4.75, 0.0, 0.0), count: 12, parts: [
                    Slot(at: (0.0, 0.0, 0.0), turn: 2, pick: [Some("walkup"), Some("walkup_tall")],
                        accents: [(150, 120, 96), (130, 110, 90), (168, 146, 112), (110, 96, 84), (140, 100, 80)]),
                ]),
                Repeat(from: (6.0, 0.0, 15.5), step: (0.0, 0.0, 4.75), count: 11, parts: [
                    Slot(at: (0.0, 0.0, 0.0), turn: 3, pick: [Some("walkup"), Some("walkup_tall")],
                        accents: [(150, 120, 96), (130, 110, 90), (168, 146, 112), (110, 96, 84), (140, 100, 80)]),
                ]),
                Repeat(from: (18.5, 0.0, 58.0), step: (4.75, 0.0, 0.0), count: 8, parts: [
                    Slot(at: (0.0, 0.0, 0.0), turn: 2, pick: [Some("walkup"), Some("walkup"), None],
                        accents: [(150, 120, 96), (130, 110, 90), (168, 146, 112), (110, 96, 84)]),
                ]),
                Slot(at: (38.0, 0.0, 36.0), pick: [Some("fountain"), Some("bandstand"), Some("pergola")]),
                Growth(area: ((27.0, 25.0), (49.0, 47.0)), kind: Soil),
                Slot(at: (24.0, 0.0, 48.0), rate: Poi, pick: [Some("poi_bench"), Some("poi_armchair")]),
            ]),
        ]),
