    name: "start_plaza",
    size: (2, 2),
    labels: ["start"],
    role: Block,
    weight: 0,
    parts: [
        Module(name: "poi_armchair", at: (17.0, 0.0, 4.0), turn: 2),
        Module(name: "street_light", at: (3.5, 0.0, 3.5), turn: 2),
        Module(name: "street_light", at: (27.5, 0.0, 3.5), turn: 2),
        Module(name: "street_light", at: (3.5, 0.0, 27.5), turn: 2),
        Module(name: "street_light", at: (27.5, 0.0, 27.5), turn: 2),
        Module(name: "bench", at: (31.0, 0.0, 3.8), turn: 2),
        Module(name: "curb_bench_bin", at: (38.0, 0.0, 3.8), turn: 2),
        Module(name: "planter", at: (9.0, 0.0, 3.8)),
