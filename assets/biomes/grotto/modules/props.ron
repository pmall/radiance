// Cyan Grotto's street furniture: tiled, like an old bathhouse district gone cold. Each module
// replaces the shared prop of its name in the grotto's zones (`world/props.rs`); same footprints and
// seat heights as the shared ones, so the flowers of the points of interest still sit right.
[
    // A tiled bench: a block of tiles with a teal seat and a low backrest, 2 m long.
    Module(
        name: "bench",
        parts: [
            Box(at: (-1.0, 0.0, -0.2), size: (2.0, 0.45, 0.45), mat: Tile),
            Box(at: (-1.0, 0.45, -0.25), size: (2.0, 0.1, 0.55), mat: Paint((40, 112, 118))),
            Box(at: (-1.0, 0.55, -0.3), size: (2.0, 0.3, 0.12), mat: Tile),
        ],
    ),
    // A litter bin: a teal drum on a tiled foot.
    Module(
        name: "bin",
        parts: [
            Box(at: (-0.2, 0.0, -0.2), size: (0.4, 0.2, 0.4), mat: Tile),
            Box(at: (-0.25, 0.2, -0.25), size: (0.5, 0.65, 0.5), mat: Paint((36, 96, 104))),
            Box(at: (-0.27, 0.85, -0.27), size: (0.54, 0.05, 0.54), mat: Metal),
        ],
    ),
    // A tiled planter, soil on top for plants to take.
    Module(
        name: "planter",
        parts: [
            Box(at: (-0.6, 0.0, -0.6), size: (1.2, 0.6, 1.2), mat: Tile),
            Box(at: (-0.65, 0.6, -0.65), size: (1.3, 0.08, 1.3), mat: StoneDark),
            Box(at: (-0.5, 0.68, -0.5), size: (1.0, 0.02, 1.0), mat: Soil),
        ],
    ),
    // A street light: a tiled plinth, a thin post, an arm out over the road (+z) and a lantern
    // hanging from it, its glass long dark. Replaces the smooth one built in code.
    Module(
        name: "street_light",
        parts: [
            Box(at: (-0.25, 0.0, -0.25), size: (0.5, 0.75, 0.5), mat: Tile),
            Box(at: (-0.1, 0.75, -0.1), size: (0.2, 6.0, 0.2), mat: Metal),
            Box(at: (-0.075, 6.5, 0.1), size: (0.15, 0.15, 1.9), mat: Metal),
            Box(at: (-0.03, 6.0, 1.82), size: (0.06, 0.5, 0.06), mat: Metal),
            Box(at: (-0.3, 5.95, 1.6), size: (0.6, 0.08, 0.5), mat: Metal),
            Box(at: (-0.25, 5.35, 1.65), size: (0.5, 0.6, 0.4), mat: Glass),
            Box(at: (-0.3, 5.27, 1.6), size: (0.6, 0.08, 0.5), mat: Metal),
        ],
    ),
    // A drinking fountain of glazed tiles where the shared utility cabinet would stand: a tiled
    // pillar, a basin, a brass spout. Same footprint.
    Module(
        name: "utility_box",
        parts: [
            Box(at: (-0.5, 0.0, -0.25), size: (1.0, 0.15, 0.5), mat: StoneDark),
            Box(at: (-0.3, 0.15, -0.2), size: (0.6, 1.1, 0.4), mat: Tile),
            Box(at: (-0.45, 0.8, -0.05), size: (0.9, 0.12, 0.3), mat: Paint((40, 112, 118))),
            Box(at: (-0.05, 1.05, 0.05), size: (0.1, 0.1, 0.25), mat: Paint((170, 130, 60))),
        ],
    ),
]

