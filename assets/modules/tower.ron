// What towers carry (docs/chunks.md, "Towers"), used by the tower chunks: on their walls, on their
// roofs, at their feet. Wall modules stand on the floor of their story at the middle of their
// bay, the wall at z = 0 and the street toward +z; roof and street modules stand on their origin.
[
    // A fire escape on the four stories above the street story: a landing at each, railed on its
    // open sides, ladders between them, alternating sides. 2.4 m wide.
    Module(
        name: "fire_escape",
        parts: [
            Repeat(from: (0.0, 5.0, 0.0), step: (0.0, 4.0, 0.0), count: 4, parts: [
                Box(at: (-1.2, -0.12, 0.02), size: (2.4, 0.12, 1.08), mat: Rust),
                Box(at: (-1.2, 0.9, 1.04), size: (2.4, 0.06, 0.06), mat: Metal),
                Box(at: (-1.2, 0.9, 0.02), size: (0.06, 0.06, 1.02), mat: Metal),
                Box(at: (1.14, 0.9, 0.02), size: (0.06, 0.06, 1.02), mat: Metal),
                Repeat(from: (-1.2, 0.0, 1.04), step: (1.175, 0.0, 0.0), count: 3, parts: [
                    Box(at: (0.0, 0.0, 0.0), size: (0.05, 0.9, 0.05), mat: Metal),
                ]),
            ]),
            Module(name: "ladder", at: (-0.9, 5.0, 0.15)),
            Module(name: "ladder", at: (0.35, 9.0, 0.15)),
            Module(name: "ladder", at: (-0.9, 13.0, 0.15)),
        ],
    ),
    // A steel ladder one story high, 0.55 m wide.
    Module(
        name: "ladder",
        parts: [
            Box(at: (0.0, 0.0, 0.0), size: (0.05, 4.0, 0.05), mat: Metal),
            Box(at: (0.5, 0.0, 0.0), size: (0.05, 4.0, 0.05), mat: Metal),
            Repeat(from: (0.0, 0.5, 0.0), step: (0.0, 0.75, 0.0), count: 5, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.55, 0.04, 0.04), mat: Metal),
            ]),
        ],
    ),
    // A blade sign over the street story, sticking out of the wall on a bracket, unlit.
    Module(
        name: "blade_sign",
        parts: [
            Box(at: (-0.03, 4.1, 0.02), size: (0.06, 0.06, 0.95), mat: Metal),
            Box(at: (-0.06, 2.9, 0.9), size: (0.12, 1.3, 1.1), mat: Accent),
            Box(at: (-0.07, 3.1, 1.0), size: (0.14, 0.9, 0.9), mat: Paint((226, 216, 190))),
        ],
    ),
    // A tall sign running up two stories at a corner of the wall, unlit.
    Module(
        name: "vertical_sign",
        parts: [
            Box(at: (-0.03, 5.0, 0.02), size: (0.06, 0.06, 0.6), mat: Metal),
            Box(at: (-0.03, 11.0, 0.02), size: (0.06, 0.06, 0.6), mat: Metal),
            Box(at: (-0.1, 4.6, 0.6), size: (0.2, 7.2, 1.0), mat: Accent),
            Box(at: (-0.11, 5.0, 0.7), size: (0.22, 6.4, 0.8), mat: Paint((214, 206, 182))),
        ],
    ),
    // Roofs.
    // A stairwell housing: a concrete box with a steel door and a vent.
    Module(
        name: "stair_housing",
        parts: [
            Box(at: (-1.6, 0.0, -1.6), size: (3.2, 3.0, 3.2), mat: Concrete),
            Box(at: (-1.7, 3.0, -1.7), size: (3.4, 0.15, 3.4), mat: Concrete),
            Box(at: (-0.5, 0.0, 1.6), size: (1.0, 2.1, 0.06), mat: Rust),
            Box(at: (0.8, 3.15, -0.6), size: (0.5, 0.6, 0.5), mat: Metal),
        ],
    ),
    // A solar array: a frame, panels of dark glass.
    Module(
        name: "roof_solar",
        parts: [
            Box(at: (-1.9, 0.0, -1.4), size: (3.8, 0.3, 2.8), mat: Metal),
            Box(at: (-1.8, 0.3, -1.3), size: (1.75, 0.08, 2.6), mat: Glass),
            Box(at: (0.05, 0.3, -1.3), size: (1.75, 0.08, 2.6), mat: Glass),
        ],
    ),
    // A skylight: a low curb and a glass top.
    Module(
        name: "roof_skylight",
        parts: [
            Box(at: (-1.0, 0.0, -1.0), size: (2.0, 0.4, 2.0), mat: Concrete),
            Box(at: (-0.9, 0.4, -0.9), size: (1.8, 0.1, 1.8), mat: Glass),
        ],
    ),
    // A pipe run along the roof, on low supports.
    Module(
        name: "roof_pipes",
        parts: [
            Box(at: (-2.0, 0.25, -0.15), size: (4.0, 0.3, 0.3), mat: Metal),
            Box(at: (-2.0, 0.25, 0.25), size: (4.0, 0.2, 0.2), mat: Rust),
            Repeat(from: (-1.6, 0.0, -0.2), step: (1.6, 0.0, 0.0), count: 3, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.12, 0.25, 0.7), mat: Metal),
            ]),
        ],
    ),
    // Big air handling units, side by side.
    Module(
        name: "roof_plant",
        parts: [
            Box(at: (-1.6, 0.0, -1.2), size: (3.2, 1.4, 2.4), mat: Metal),
            Box(at: (-1.2, 1.4, -0.8), size: (0.9, 0.2, 0.9), mat: Paint((40, 42, 46))),
            Box(at: (0.3, 1.4, -0.8), size: (0.9, 0.2, 0.9), mat: Paint((40, 42, 46))),
            Box(at: (-1.5, 0.0, 1.2), size: (0.6, 0.6, 0.4), mat: Rust),
        ],
    ),
    // A radio mast, tall on the high roofs.
    Module(
        name: "roof_mast",
        parts: [
            Box(at: (-0.6, 0.0, -0.6), size: (1.2, 0.3, 1.2), mat: Concrete),
            Box(at: (-0.18, 0.3, -0.18), size: (0.36, 18.0, 0.36), mat: Metal),
            Repeat(from: (-0.9, 4.0, -0.04), step: (0.0, 4.0, 0.0), count: 4, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (1.8, 0.08, 0.08), mat: Metal),
            ]),
            Box(at: (-0.06, 18.3, -0.06), size: (0.12, 3.0, 0.12), mat: Paint((176, 52, 44))),
        ],
    ),
    // A billboard on posts facing +z, its print long faded: a frame, the panel in the accent
    // color, a pale field where the picture was. 8 m wide.
    Module(
        name: "billboard",
        parts: [
            Repeat(from: (-3.0, 0.0, -0.15), step: (6.0, 0.0, 0.0), count: 2, parts: [
                Box(at: (-0.15, 0.0, 0.0), size: (0.3, 1.6, 0.3), mat: Metal),
            ]),
            Box(at: (-4.0, 1.6, -0.2), size: (8.0, 4.2, 0.3), mat: Metal),
            Box(at: (-3.8, 1.8, 0.1), size: (7.6, 3.8, 0.05), mat: Accent),
            Box(at: (-3.2, 2.2, 0.12), size: (4.4, 3.0, 0.05), mat: Paint((214, 206, 182))),
            Box(at: (-4.0, 1.4, 0.1), size: (8.0, 0.1, 0.6), mat: Metal),
        ],
    ),
    // A helipad on a high roof: a raised deck of steel on legs, a pale ring and the H painted
    // on it, a low rail round the edge. 10 m across, centered.
    Module(
        name: "helipad",
        parts: [
            Repeat(from: (-4.0, 0.0, -4.0), step: (8.0, 0.0, 0.0), count: 2, parts: [
                Repeat(step: (0.0, 0.0, 8.0), count: 2, parts: [
                    Box(at: (-0.2, 0.0, -0.2), size: (0.4, 1.2, 0.4), mat: Metal),
                ]),
            ]),
            Box(at: (-5.0, 1.2, -5.0), size: (10.0, 0.3, 10.0), mat: Metal),
            Box(at: (-3.6, 1.5, -3.6), size: (7.2, 0.02, 0.4), mat: Paint((214, 206, 182))),
            Box(at: (-3.6, 1.5, 3.2), size: (7.2, 0.02, 0.4), mat: Paint((214, 206, 182))),
            Box(at: (-3.6, 1.5, -3.2), size: (0.4, 0.02, 6.4), mat: Paint((214, 206, 182))),
            Box(at: (3.2, 1.5, -3.2), size: (0.4, 0.02, 6.4), mat: Paint((214, 206, 182))),
            Box(at: (-1.4, 1.5, -1.8), size: (0.5, 0.02, 3.6), mat: Paint((220, 180, 60))),
            Box(at: (0.9, 1.5, -1.8), size: (0.5, 0.02, 3.6), mat: Paint((220, 180, 60))),
            Box(at: (-0.9, 1.5, -0.25), size: (1.8, 0.02, 0.5), mat: Paint((220, 180, 60))),
            Box(at: (-5.0, 1.5, -5.0), size: (10.0, 0.5, 0.1), mat: Metal),
            Box(at: (-5.0, 1.5, 4.9), size: (10.0, 0.5, 0.1), mat: Metal),
        ],
    ),
    // A lattice mast: four steel legs braced every 3 m, a platform half way, a dead beacon on
    // top. 34 m tall, 3 m across, centered: the telecom tower's spike on the skyline.
    Module(
        name: "lattice_mast",
        parts: [
            Box(at: (-2.0, 0.0, -2.0), size: (4.0, 0.4, 4.0), mat: Concrete),
            Repeat(from: (-1.5, 0.4, -1.5), step: (2.8, 0.0, 0.0), count: 2, parts: [
                Repeat(step: (0.0, 0.0, 2.8), count: 2, parts: [
                    Box(at: (0.0, 0.0, 0.0), size: (0.2, 34.0, 0.2), mat: Metal),
                ]),
            ]),
            Repeat(from: (-1.5, 3.0, -1.5), step: (0.0, 3.0, 0.0), count: 11, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (3.0, 0.12, 0.12), mat: Metal),
                Box(at: (0.0, 0.0, 2.8), size: (3.0, 0.12, 0.12), mat: Metal),
                Box(at: (0.0, 0.0, 0.0), size: (0.12, 0.12, 3.0), mat: Metal),
                Box(at: (2.8, 0.0, 0.0), size: (0.12, 0.12, 3.0), mat: Metal),
            ]),
            Box(at: (-2.2, 16.0, -2.2), size: (4.4, 0.2, 4.4), mat: Rust),
            Box(at: (-2.2, 16.2, -2.2), size: (4.4, 0.8, 0.08), mat: Rust),
            Box(at: (-2.2, 16.2, 2.12), size: (4.4, 0.8, 0.08), mat: Rust),
            Box(at: (1.6, 20.0, -0.6), size: (0.6, 2.4, 1.2), mat: Paint((200, 200, 190))),
            Box(at: (-2.2, 26.0, -0.6), size: (0.6, 2.4, 1.2), mat: Paint((200, 200, 190))),
            Box(at: (-0.15, 34.4, -0.15), size: (0.3, 4.0, 0.3), mat: Metal),
            Box(at: (-0.25, 38.4, -0.25), size: (0.5, 0.5, 0.5), mat: Paint((176, 52, 44))),
        ],
    ),
    // A dish on a wall bracket, its face toward +z and tipped up: a steel arm, a drum of pale
    // rings (the dish in boxes), a feed rod.
    Module(
        name: "wall_dish",
        parts: [
            Box(at: (-0.15, 0.0, 0.0), size: (0.3, 0.3, 1.2), mat: Metal),
            Box(at: (-0.1, -0.8, 0.0), size: (0.2, 0.8, 0.2), mat: Metal),
            Box(at: (-1.2, -0.6, 1.2), size: (2.4, 1.6, 0.25), mat: Paint((200, 200, 190))),
            Box(at: (-0.8, -1.0, 1.25), size: (1.6, 2.4, 0.25), mat: Paint((200, 200, 190))),
            Box(at: (-1.0, -0.8, 1.45), size: (2.0, 2.0, 0.1), mat: Paint((176, 176, 168))),
            Box(at: (-0.05, 0.15, 1.5), size: (0.1, 0.1, 1.4), mat: Metal),
        ],
    ),
    // A rooftop sign facing +z: letters on a steel frame of posts and braces, each a panel in the
    // accent color, long unlit. 14 m wide.
    Module(
        name: "roof_letters",
        parts: [
            Repeat(from: (-6.5, 0.0, -0.1), step: (3.25, 0.0, 0.0), count: 5, parts: [
                Box(at: (-0.1, 0.0, 0.0), size: (0.2, 6.5, 0.2), mat: Metal),
                Box(at: (-0.06, 0.0, -1.6), size: (0.12, 0.12, 1.7), mat: Metal),
            ]),
            Repeat(from: (-7.0, 1.0, -0.1), step: (0.0, 2.5, 0.0), count: 2, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (14.0, 0.15, 0.15), mat: Metal),
            ]),
            Repeat(from: (-6.8, 1.6, 0.12), step: (2.8, 0.0, 0.0), count: 5, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (2.2, 4.6, 0.12), mat: Accent),
                Box(at: (0.6, 1.0, 0.13), size: (1.0, 0.6, 0.06), mat: Paint((40, 42, 46))),
                Box(at: (0.6, 2.8, 0.13), size: (1.0, 0.6, 0.06), mat: Paint((40, 42, 46))),
            ]),
        ],
    ),
]
