// Housing and shop units: the repeated, varied cells that make a Nivalis wall. Each stands on its
// origin, its front toward +z. `Accent` surfaces take the color the chunk gives.
[
    // A window with a sill; under it, sometimes, an air conditioner, a cage or laundry.
    Module(
        name: "unit_window",
        parts: [
            Box(at: (-0.6, 0.0, 0.0), size: (1.2, 1.8, 0.1), mat: Glass),
            Box(at: (-0.7, -0.12, 0.0), size: (1.4, 0.12, 0.3), mat: Concrete),
            Box(at: (-0.7, 1.8, 0.0), size: (1.4, 0.15, 0.2), mat: Concrete),
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("ac_unit"), Some("window_cage"), Some("laundry"), None, None]),
        ],
    ),
    // An air conditioner hanging under the window, its fan grille dark.
    Module(
        name: "ac_unit",
        parts: [
            Box(at: (-0.4, -0.75, 0.0), size: (0.8, 0.55, 0.45), mat: Metal),
            Box(at: (-0.3, -0.68, 0.45), size: (0.45, 0.4, 0.03), mat: Paint((40, 42, 46))),
            Box(at: (-0.05, -0.2, 0.1), size: (0.1, 0.2, 0.1), mat: Metal),
        ],
    ),
    // A burglar cage over the window: thin bars, top and bottom rails.
    Module(
        name: "window_cage",
        parts: [
            Box(at: (-0.75, -0.1, 0.0), size: (1.5, 0.08, 0.4), mat: Metal),
            Box(at: (-0.75, 1.9, 0.0), size: (1.5, 0.08, 0.4), mat: Metal),
            Repeat(from: (-0.72, -0.1, 0.34), step: (0.24, 0.0, 0.0), count: 7, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.05, 2.08, 0.05), mat: Rust),
            ]),
        ],
    ),
    // Laundry left out on a line in front of the window: a cloth in the accent color, two pale.
    Module(
        name: "laundry",
        parts: [
            Box(at: (-0.9, 1.6, 0.5), size: (1.8, 0.03, 0.03), mat: Metal),
            Box(at: (-0.8, 0.9, 0.5), size: (0.45, 0.7, 0.04), mat: Accent),
            Box(at: (-0.25, 1.1, 0.5), size: (0.5, 0.5, 0.04), mat: Paint((200, 196, 180))),
            Box(at: (0.35, 0.8, 0.5), size: (0.4, 0.8, 0.04), mat: Paint((120, 140, 170))),
        ],
    ),
    // A water tank on four legs, for roofs.
    Module(
        name: "water_tank",
        parts: [
            Mirror2(axis: X, at: 0.0, parts: [
                Mirror2(axis: Z, at: 0.0, parts: [
                    Box(at: (0.6, 0.0, 0.6), size: (0.15, 1.2, 0.15), mat: Metal),
                ]),
            ]),
            Box(at: (-0.9, 1.2, -0.9), size: (1.8, 1.6, 1.8), mat: Rust),
            Box(at: (-0.95, 2.8, -0.95), size: (1.9, 0.12, 1.9), mat: Metal),
        ],
    ),
    // A narrow shophouse, 6 m wide and 12 m deep: a shop with a striped awning and a sign band at
    // street level, two stories of windows above in the accent color, a flat roof.
    Module(
        name: "shophouse",
        parts: [
            Box(at: (-3.0, 0.0, -12.0), size: (6.0, 4.0, 11.6), mat: Concrete),
            Box(at: (-3.0, 0.0, -0.4), size: (0.6, 4.0, 0.4), mat: Concrete),
            Box(at: (2.4, 0.0, -0.4), size: (0.6, 4.0, 0.4), mat: Concrete),
            Box(at: (-2.4, 0.3, -0.4), size: (4.8, 2.4, 0.1), mat: Glass),
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("shutter_half"), Some("shutter_down"), None]),
            Box(at: (-3.0, 3.05, -0.4), size: (6.0, 0.9, 0.3), mat: Accent),
            Repeat(from: (-3.0, 2.75, -0.1), step: (1.0, 0.0, 0.0), count: 6, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.5, 0.1, 1.6), mat: Accent),
                Box(at: (0.5, 0.0, 0.0), size: (0.5, 0.1, 1.6), mat: Paint((222, 210, 180))),
            ]),
            Box(at: (-3.0, 4.0, -12.0), size: (6.0, 8.5, 11.6), mat: Accent),
            Box(at: (-3.1, 4.0, -0.4), size: (6.2, 0.3, 0.5), mat: Concrete),
            Box(at: (-3.1, 8.2, -0.4), size: (6.2, 0.3, 0.5), mat: Concrete),
            Box(at: (-3.1, 12.5, -12.1), size: (6.2, 0.6, 12.2), mat: Concrete),
            Repeat(from: (-1.5, 5.0, -0.4), step: (3.0, 0.0, 0.0), count: 2, parts: [
                Repeat(step: (0.0, 4.2, 0.0), count: 2, parts: [
                    Module(name: "unit_window"),
                ]),
            ]),
            Slot(at: (0.0, 13.1, -6.0), pick: [Some("water_tank"), None, None]),
        ],
    ),
    // The same, one story taller.
    Module(
        name: "shophouse_tall",
        parts: [
            Module(name: "shophouse"),
            Box(at: (-3.0, 13.1, -12.0), size: (6.0, 4.2, 11.6), mat: Accent),
            Box(at: (-3.1, 17.3, -12.1), size: (6.2, 0.6, 12.2), mat: Concrete),
            Repeat(from: (-1.5, 13.6, -0.4), step: (3.0, 0.0, 0.0), count: 2, parts: [
                Module(name: "unit_window"),
            ]),
        ],
    ),
    // Shop shutters, half or fully down.
    Module(
        name: "shutter_half",
        parts: [
            Box(at: (-2.4, 1.6, -0.3), size: (4.8, 1.1, 0.12), mat: Metal),
        ],
    ),
    Module(
        name: "shutter_down",
        parts: [
            Box(at: (-2.4, 0.3, -0.3), size: (4.8, 2.4, 0.12), mat: Metal),
        ],
    ),
    // A string of small flags across a lane, in the accent color and pale.
    Module(
        name: "banner_string",
        parts: [
            Box(at: (-0.02, 0.0, 0.0), size: (0.04, 0.04, 14.0), mat: Metal),
            Repeat(from: (-0.02, -0.6, 0.6), step: (0.0, 0.0, 2.0), count: 7, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.04, 0.6, 0.7), mat: Accent),
            ]),
            Repeat(from: (-0.02, -0.5, 1.6), step: (0.0, 0.0, 2.0), count: 6, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.04, 0.5, 0.6), mat: Paint((222, 210, 180))),
            ]),
        ],
    ),
    // The covered market hall: a metal roof with skylight strips on a grid of concrete pillars.
    // 96 x 56 m, centered on its origin.
    Module(
        name: "market_hall",
        parts: [
            Repeat(from: (-44.0, 0.0, -24.0), step: (8.0, 0.0, 0.0), count: 12, parts: [
                Repeat(step: (0.0, 0.0, 8.0), count: 7, parts: [
                    Box(at: (-0.4, 0.0, -0.4), size: (0.8, 8.0, 0.8), mat: Concrete),
                ]),
            ]),
            Box(at: (-48.0, 8.0, -28.0), size: (96.0, 0.8, 56.0), mat: Metal),
            Repeat(from: (-40.0, 8.8, -26.0), step: (16.0, 0.0, 0.0), count: 6, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (4.0, 0.4, 52.0), mat: Glass),
            ]),
            Box(at: (-48.0, 7.4, -28.0), size: (96.0, 0.6, 0.4), mat: Accent),
            Box(at: (-48.0, 7.4, 27.6), size: (96.0, 0.6, 0.4), mat: Accent),
        ],
    ),
    // A walk-up: a narrow house 4.5 m wide and 7 m deep, three stories in the accent color over a
    // concrete ground floor (a door and a shop window, or a shutter), a window per story above,
    // sometimes a balcony; a parapet and roof clutter on top. Front toward +z, back at z = -7.
    Module(
        name: "walkup",
        parts: [
            Box(at: (-2.25, 0.0, -7.0), size: (4.5, 3.4, 6.8), mat: Concrete),
            Box(at: (-2.25, 3.4, -7.0), size: (4.5, 6.4, 6.8), mat: Accent),
            Box(at: (-1.9, 0.0, -0.25), size: (1.0, 2.3, 0.1), mat: Paint((44, 40, 38))),
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("walkup_shop"), Some("shutter_small"), Some("walkup_shop")]),
            Box(at: (-2.3, 3.2, -0.2), size: (4.6, 0.25, 0.4), mat: Concrete),
            Module(name: "unit_window", at: (0.6, 4.4, -0.2)),
            Slot(at: (0.6, 7.6, -0.2), pick: [Some("unit_window"), Some("unit_window"), Some("balcony")]),
            Box(at: (-2.3, 9.8, -7.05), size: (4.6, 0.7, 6.9), mat: Concrete),
            Slot(at: (0.0, 10.5, -3.5), pick: [Some("water_tank"), Some("roof_ac"), None, None]),
        ],
    ),
    // The same, a story taller.
    Module(
        name: "walkup_tall",
        parts: [
            Box(at: (-2.25, 0.0, -7.0), size: (4.5, 3.4, 6.8), mat: Concrete),
            Box(at: (-2.25, 3.4, -7.0), size: (4.5, 9.6, 6.8), mat: Accent),
            Box(at: (-1.9, 0.0, -0.25), size: (1.0, 2.3, 0.1), mat: Paint((44, 40, 38))),
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("walkup_shop"), Some("shutter_small")]),
            Box(at: (-2.3, 3.2, -0.2), size: (4.6, 0.25, 0.4), mat: Concrete),
            Repeat(from: (0.6, 4.4, -0.2), step: (0.0, 3.2, 0.0), count: 3, parts: [
                Slot(at: (0.0, 0.0, 0.0), pick: [Some("unit_window"), Some("unit_window"), Some("balcony")]),
            ]),
            Box(at: (-2.3, 13.0, -7.05), size: (4.6, 0.7, 6.9), mat: Concrete),
            Slot(at: (0.0, 13.7, -3.5), pick: [Some("water_tank"), Some("roof_ac"), Some("antenna"), None]),
        ],
    ),
    // A walk-up's shop window, a sign band in the accent color over it.
    Module(
        name: "walkup_shop",
        parts: [
            Box(at: (-0.7, 0.4, -0.25), size: (2.7, 2.0, 0.1), mat: Glass),
            Box(at: (-0.8, 2.5, -0.25), size: (2.9, 0.6, 0.35), mat: Accent),
            Box(at: (-0.8, 2.45, -0.25), size: (2.9, 0.08, 1.0), mat: Metal),
        ],
    ),
    Module(
        name: "shutter_small",
        parts: [
            Box(at: (-0.7, 0.0, -0.2), size: (2.7, 2.6, 0.12), mat: Metal),
            Box(at: (-0.8, 2.6, -0.25), size: (2.9, 0.4, 0.4), mat: Rust),
        ],
    ),
    // A small balcony in place of a window: a door, a slab, a railing, sometimes laundry or pots.
    Module(
        name: "balcony",
        parts: [
            Box(at: (-0.5, 0.0, 0.0), size: (1.0, 2.2, 0.1), mat: Glass),
            Box(at: (-1.3, -0.3, 0.0), size: (2.6, 0.2, 1.0), mat: Concrete),
            Box(at: (-1.3, -0.1, 0.9), size: (2.6, 1.0, 0.08), mat: Metal),
            Box(at: (-1.3, -0.1, 0.1), size: (0.08, 1.0, 0.8), mat: Metal),
            Box(at: (1.22, -0.1, 0.1), size: (0.08, 1.0, 0.8), mat: Metal),
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("laundry"), Some("balcony_pots"), None]),
        ],
    ),
    Module(
        name: "balcony_pots",
        parts: [
            Box(at: (-1.1, -0.1, 0.5), size: (0.35, 0.35, 0.35), mat: Paint((150, 84, 60))),
            Box(at: (-1.05, 0.25, 0.55), size: (0.25, 0.04, 0.25), mat: Soil),
            Box(at: (0.7, -0.1, 0.45), size: (0.4, 0.3, 0.4), mat: Paint((150, 84, 60))),
            Box(at: (0.75, 0.2, 0.5), size: (0.3, 0.04, 0.3), mat: Soil),
        ],
    ),
    // Roof clutter: an air conditioner block, an antenna.
    Module(
        name: "roof_ac",
        parts: [
            Box(at: (-0.7, 0.0, -0.5), size: (1.4, 1.0, 1.0), mat: Metal),
            Box(at: (-0.5, 1.0, -0.3), size: (1.0, 0.1, 0.6), mat: Paint((40, 42, 46))),
            Box(at: (0.9, 0.0, -0.4), size: (0.8, 0.7, 0.8), mat: Metal),
        ],
    ),
    Module(
        name: "antenna",
        parts: [
            Box(at: (-0.05, 0.0, -0.05), size: (0.1, 3.5, 0.1), mat: Metal),
            Box(at: (-0.8, 2.6, -0.03), size: (1.6, 0.06, 0.06), mat: Metal),
            Box(at: (-0.5, 3.1, -0.03), size: (1.0, 0.06, 0.06), mat: Metal),
        ],
    ),
    // A housing block of five stories, 12 m square, centered on its origin: shop fronts on the
    // street story, a grid of windows above (each with its own luck: a cage, an air conditioner,
    // laundry, a balcony), cornices, roof tanks. The accent color paints the walls.
    Module(
        name: "housing_block",
        parts: [
            Box(at: (-6.0, 0.0, -6.0), size: (12.0, 4.0, 12.0), mat: Concrete),
            Box(at: (-6.0, 4.0, -6.0), size: (12.0, 16.0, 12.0), mat: Accent),
            Box(at: (-6.2, 20.0, -6.2), size: (12.4, 0.8, 12.4), mat: Concrete),
            Mirror4(center: (0.0, 0.0), parts: [
                Box(at: (-6.1, 3.8, 5.8), size: (12.2, 0.3, 0.5), mat: Concrete),
                Box(at: (-6.1, 11.8, 5.9), size: (12.2, 0.25, 0.35), mat: Concrete),
                Slot(at: (-3.0, 0.0, 6.0), pick: [Some("walkup_shop"), Some("shutter_small"), None]),
                Slot(at: (3.0, 0.0, 6.0), pick: [Some("walkup_shop"), Some("shutter_small"), None]),
                Repeat(from: (-4.5, 5.0, 6.0), step: (3.0, 0.0, 0.0), count: 4, parts: [
                    Repeat(step: (0.0, 4.0, 0.0), count: 4, parts: [
                        Slot(at: (0.0, 0.0, 0.0), pick: [Some("unit_window"), Some("unit_window"), Some("unit_window"), Some("balcony"), Some("boarded")]),
                    ]),
                ]),
            ]),
            Slot(at: (-3.0, 20.8, -2.0), pick: [Some("water_tank"), Some("roof_ac")]),
            Slot(at: (2.5, 20.8, 2.0), pick: [Some("water_tank"), Some("antenna"), None]),
        ],
    ),
    // A window boarded up with planks.
    Module(
        name: "boarded",
        parts: [
            Box(at: (-0.65, 0.0, 0.0), size: (1.3, 1.9, 0.12), mat: Wood),
            Box(at: (-0.7, 0.4, 0.12), size: (1.4, 0.2, 0.05), mat: Wood),
            Box(at: (-0.7, 1.3, 0.12), size: (1.4, 0.2, 0.05), mat: Wood),
        ],
    ),
]
