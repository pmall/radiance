// Special places and the buildings along the streets (milestone 10, pass 6): row houses that
// line the sidewalks around a courtyard, and the furniture of the squares, shrines, playgrounds,
// bus terminals, monuments and open-air theaters the planner scatters on every floor
// (`assets/biomes/default/chunks/`). Each stands on its origin, its front toward +z.
[
    // A row house 4.75 m wide and 4.5 m deep, its front at z = 0 on the sidewalk: a shop or a
    // shuttered front at street level, three stories of windows in its accent color, a cornice,
    // something on the roof.
    Module(
        name: "rowhouse",
        parts: [
            Box(at: (-2.375, 0.0, -4.5), size: (4.75, 3.4, 4.5), mat: Concrete),
            Box(at: (-2.375, 3.4, -4.5), size: (4.75, 9.6, 4.5), mat: Accent),
            Box(at: (-1.9, 0.0, -0.25), size: (1.0, 2.3, 0.1), mat: Paint((44, 40, 38))),
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("walkup_shop"), Some("shutter_small"), Some("walkup_shop")]),
            Box(at: (-2.4, 3.2, -0.2), size: (4.8, 0.25, 0.4), mat: Concrete),
            Repeat(from: (0.6, 4.4, -0.2), step: (0.0, 3.2, 0.0), count: 3, parts: [
                Slot(at: (0.0, 0.0, 0.0), pick: [Some("unit_window"), Some("unit_window"), Some("balcony"),
                    Some("boarded")]),
            ]),
            Box(at: (-2.4, 13.0, -4.55), size: (4.8, 0.6, 4.6), mat: Concrete),
            Slot(at: (0.0, 13.6, -2.25), pick: [Some("water_tank"), Some("roof_ac"), Some("antenna"), None]),
        ],
    ),
    // The back of a row house on a quiet side: no shop, a back door, small windows.
    Module(
        name: "rowhouse_back",
        parts: [
            Box(at: (-2.375, 0.0, -4.5), size: (4.75, 3.4, 4.5), mat: Brick),
            Box(at: (-2.375, 3.4, -4.5), size: (4.75, 9.6, 4.5), mat: Accent),
            Box(at: (0.6, 0.0, -0.25), size: (1.0, 2.2, 0.1), mat: Paint((60, 52, 44))),
            Repeat(from: (-0.9, 4.6, -0.2), step: (0.0, 3.2, 0.0), count: 3, parts: [
                Slot(at: (0.0, 0.0, 0.0), pick: [Some("unit_window"), Some("boarded"), None]),
            ]),
            Box(at: (-2.4, 13.0, -4.55), size: (4.8, 0.6, 4.6), mat: Concrete),
        ],
    ),
    // Two row houses side by side, from x = 0 to 9.5, each its own color.
    Module(
        name: "row_pair",
        parts: [
            Slot(at: (2.375, 0.0, 0.0), pick: [Some("rowhouse")],
                accents: [(176, 92, 66), (70, 124, 116), (196, 160, 90), (120, 136, 84), (150, 100, 124),
                          (84, 110, 150), (200, 130, 100), (136, 132, 124), (110, 70, 64)]),
            Slot(at: (7.125, 0.0, 0.0), pick: [Some("rowhouse")],
                accents: [(176, 92, 66), (70, 124, 116), (196, 160, 90), (120, 136, 84), (150, 100, 124),
                          (84, 110, 150), (200, 130, 100), (136, 132, 124), (110, 70, 64)]),
        ],
    ),
    Module(
        name: "row_pair_back",
        parts: [
            Slot(at: (2.375, 0.0, 0.0), pick: [Some("rowhouse_back")],
                accents: [(150, 120, 100), (110, 120, 112), (160, 140, 110), (120, 110, 100)]),
            Slot(at: (7.125, 0.0, 0.0), pick: [Some("rowhouse_back"), None],
                accents: [(150, 120, 100), (110, 120, 112), (160, 140, 110), (120, 110, 100)]),
        ],
    ),
    // A shrine: a stepped stone platform, four red columns, a tiered roof, a stone lantern on each
