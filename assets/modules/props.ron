// Props: what people left in the streets, box-built in the city's materials. Placed by the
// street dressing (`src/world/dressing.rs`) as whole props. Each stands on its origin, centered,
// its front (the side people use) toward +z.
[
    // An armchair left outside: a seat block, a back, two arms, a cushion.
    Module(
        name: "armchair",
        parts: [
            Box(at: (-0.42, 0.0, -0.4), size: (0.84, 0.38, 0.8), mat: Paint((118, 62, 54))),
            Box(at: (-0.42, 0.38, -0.4), size: (0.84, 0.56, 0.2), mat: Paint((104, 54, 48))),
            Box(at: (-0.42, 0.38, -0.2), size: (0.16, 0.24, 0.6), mat: Paint((104, 54, 48))),
            Box(at: (0.26, 0.38, -0.2), size: (0.16, 0.24, 0.6), mat: Paint((104, 54, 48))),
            Box(at: (-0.26, 0.38, -0.2), size: (0.52, 0.1, 0.58), mat: Paint((140, 78, 66))),
        ],
    ),
    // A sofa, 2 m.
    Module(
        name: "sofa",
        parts: [
            Box(at: (-1.0, 0.0, -0.45), size: (2.0, 0.38, 0.9), mat: Paint((70, 84, 96))),
            Box(at: (-1.0, 0.38, -0.45), size: (2.0, 0.5, 0.22), mat: Paint((62, 74, 86))),
