            Box(at: (-0.8, 0.38, -0.23), size: (0.78, 0.1, 0.66), mat: Paint((86, 102, 116))),
            Box(at: (0.02, 0.38, -0.23), size: (0.78, 0.1, 0.66), mat: Paint((86, 102, 116))),
        ],
    ),
    // A terracotta pot, soil inside.
    Module(
        name: "clay_pot",
        parts: [
            Box(at: (-0.13, 0.0, -0.13), size: (0.26, 0.24, 0.26), mat: Paint((166, 92, 58))),
            Box(at: (-0.16, 0.24, -0.16), size: (0.32, 0.06, 0.32), mat: Paint((180, 104, 66))),
