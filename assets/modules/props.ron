    // An oil drum, rusted, with its hoops; and one still painted blue.
    Module(
        name: "barrel",
        parts: [
            Box(at: (-0.29, 0.0, -0.29), size: (0.58, 0.88, 0.58), mat: Rust),
            Box(at: (-0.31, 0.2, -0.31), size: (0.62, 0.05, 0.62), mat: Metal),
