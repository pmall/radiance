            Box(at: (-0.3, 0.88, -0.3), size: (0.6, 0.03, 0.6), mat: Metal),
        ],
    ),
    Module(
        name: "barrel_blue",
        parts: [
            Box(at: (-0.29, 0.0, -0.29), size: (0.58, 0.88, 0.58), mat: Paint((52, 84, 130))),
