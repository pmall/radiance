// Architectural pieces. Each stands on its origin, its outer face toward +z.
[
    // An arcade column with a base and a capital, 6 m.
    Module(
        name: "column",
        parts: [
            Box(at: (-0.6, 0.0, -0.6), size: (1.2, 0.5, 1.2), mat: StoneDark),
            Box(at: (-0.4, 0.5, -0.4), size: (0.8, 5.0, 0.8), mat: Stone),
            Box(at: (-0.6, 5.5, -0.6), size: (1.2, 0.5, 1.2), mat: StoneDark),
        ],
    ),
    // A window on a facade facing +z: dark glass with a sill and a lintel standing out of the wall.
    Module(
        name: "window",
        parts: [
            Box(at: (-0.75, 0.0, 0.0), size: (1.5, 2.0, 0.1), mat: Glass),
            Box(at: (-0.9, -0.2, 0.0), size: (1.8, 0.2, 0.3), mat: Stone),
            Box(at: (-0.9, 2.0, 0.0), size: (1.8, 0.25, 0.2), mat: Stone),
        ],
    ),
    // A shop front under an arcade: glass between two piers, a sign band above.
    Module(
        name: "shopfront",
        parts: [
            Box(at: (-2.5, 0.0, 0.0), size: (5.0, 0.4, 0.2), mat: StoneDark),
            Box(at: (-2.4, 0.4, 0.0), size: (4.8, 3.2, 0.1), mat: Glass),
            Box(at: (-2.5, 3.6, 0.0), size: (5.0, 0.9, 0.3), mat: Paint((70, 56, 48))),
            Box(at: (-3.0, 0.0, 0.0), size: (0.5, 6.0, 0.4), mat: Stone),
        ],
    ),
    // The dry fountain at the heart of a square: a wide basin gone to soil, a pedestal, a bowl.
    Module(
        name: "fountain",
        parts: [
            Mirror4(center: (0.0, 0.0), parts: [
                Box(at: (-12.0, 0.0, 11.4), size: (23.4, 0.7, 0.6), mat: StoneDark),
            ]),
            Box(at: (-11.4, 0.0, -11.4), size: (22.8, 0.3, 22.8), mat: Soil),
            Box(at: (-2.5, 0.0, -2.5), size: (5.0, 1.5, 5.0), mat: StoneDark),
            Box(at: (-0.75, 1.5, -0.75), size: (1.5, 5.0, 1.5), mat: Stone),
            Box(at: (-2.5, 6.5, -2.5), size: (5.0, 0.5, 5.0), mat: Stone),
            Mirror4(center: (0.0, 0.0), parts: [
                Box(at: (-2.5, 7.0, 2.2), size: (4.7, 0.5, 0.3), mat: Stone),
            ]),
        ],
    ),
    // One 12 m bay of an arcaded building, 20 m deep, its front at z = 20: two shops at street level
    // behind the arcade, five stories of windows above. Origin at its back left corner.
    Module(
        name: "arcade_bay",
        parts: [
            Box(at: (0.0, 0.0, 0.0), size: (12.0, 6.0, 12.0), mat: Concrete),
            Box(at: (0.0, 6.0, 0.0), size: (12.0, 22.0, 20.0), mat: Brick),
            Box(at: (0.0, 28.0, 19.4), size: (12.0, 1.0, 0.6), mat: Concrete),
            Box(at: (0.0, 6.0, 19.8), size: (12.0, 0.6, 0.4), mat: StoneDark),
            Module(name: "shopfront", at: (3.0, 0.0, 12.0)),
            Module(name: "shopfront", at: (9.0, 0.0, 12.0)),
            Module(name: "column", at: (6.0, 0.0, 19.4)),
            Module(name: "column", at: (11.4, 0.0, 19.4)),
            Repeat(from: (2.0, 8.0, 20.0), step: (4.0, 0.0, 0.0), count: 3, parts: [
                Repeat(step: (0.0, 3.6, 0.0), count: 5, parts: [
                    Module(name: "window", at: (0.0, 0.0, 0.0)),
                ]),
            ]),
        ],
    ),
]
