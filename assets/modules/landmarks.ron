    Module(
        name: "shed_bay",
        parts: [
            Box(at: (0.0, 0.0, -20.0), size: (0.6, 14.0, 0.6), mat: Rust),
            Box(at: (0.0, 0.0, 19.4), size: (0.6, 14.0, 0.6), mat: Rust),
            Box(at: (0.0, 14.0, -20.0), size: (12.0, 0.6, 6.0), mat: Metal),
            Box(at: (0.0, 14.0, 14.0), size: (12.0, 0.6, 6.0), mat: Metal),
            Box(at: (0.0, 17.0, -14.0), size: (12.0, 0.6, 6.0), mat: Metal),
            Box(at: (0.0, 17.0, 8.0), size: (12.0, 0.6, 6.0), mat: Metal),
            Box(at: (0.0, 19.5, -8.0), size: (12.0, 0.5, 5.0), mat: Metal),
            Box(at: (0.0, 19.5, 3.0), size: (12.0, 0.5, 5.0), mat: Metal),
            Box(at: (0.0, 21.0, -3.0), size: (12.0, 0.3, 6.0), mat: Glass),
            Box(at: (0.0, 14.6, -14.6), size: (0.4, 2.4, 0.4), mat: Rust),
            Box(at: (0.0, 14.6, 14.2), size: (0.4, 2.4, 0.4), mat: Rust),
            Box(at: (0.0, 17.6, -8.6), size: (0.4, 1.9, 0.4), mat: Rust),
            Box(at: (0.0, 17.6, 8.2), size: (0.4, 1.9, 0.4), mat: Rust),
            Box(at: (0.0, 20.0, -3.4), size: (0.4, 1.0, 0.4), mat: Rust),
            Box(at: (0.0, 20.0, 3.0), size: (0.4, 1.0, 0.4), mat: Rust),
        ],
    ),
    // 12 m of a platform toward +x, 8 m wide, its middle at z = 0: a raised slab, its edge
    // painted, a bench and a sign between the columns.
    Module(
        name: "platform_bay",
        parts: [
            Box(at: (0.0, 0.0, -4.0), size: (12.0, 1.0, 8.0), mat: StoneDark),
            Box(at: (0.0, 1.0, -4.0), size: (12.0, 0.02, 0.4), mat: Paint((200, 170, 60))),
            Box(at: (0.0, 1.0, 3.6), size: (12.0, 0.02, 0.4), mat: Paint((200, 170, 60))),
            Box(at: (5.8, 1.0, -0.2), size: (0.4, 5.0, 0.4), mat: Metal),
            Box(at: (0.0, 6.0, -3.0), size: (12.0, 0.3, 6.0), mat: Metal),
            Slot(at: (3.0, 1.0, 0.0), pick: [Some("bench"), Some("bench"), Some("kiosk"), None]),
