            Box(at: (8.0, 4.5, -0.05), size: (2.4, 0.8, 0.1), mat: Paint((30, 34, 40))),
        ],
    ),
    // A tier of stadium seats, 12 m along x, rising toward -z: ten steps 1 m deep and 0.6 m
    // high, the seats in the accent color. Front edge at z = 0.
    Module(
        name: "stand_bay",
        parts: [
            Repeat(from: (0.0, 0.0, -1.0), step: (0.0, 0.6, -1.0), count: 10, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (12.0, 0.6, 1.0), mat: Concrete),
                Box(at: (0.0, 0.6, 0.5), size: (12.0, 0.08, 0.4), mat: Accent),
            ]),
            Box(at: (0.0, 0.0, -11.0), size: (12.0, 6.0, 1.0), mat: Concrete),
            Box(at: (0.0, 6.0, -11.0), size: (12.0, 1.2, 0.3), mat: Concrete),
        ],
    ),
    // A stand's roof: two columns at the back, a cantilever slab reaching over the tiers.
    Module(
        name: "stand_roof",
        parts: [
            Box(at: (0.0, 0.0, -11.5), size: (0.6, 16.0, 0.6), mat: Metal),
            Box(at: (0.0, 16.0, -12.0), size: (12.0, 0.5, 12.0), mat: Metal),
            Box(at: (0.0, 15.0, -11.5), size: (12.0, 1.0, 0.4), mat: Metal),
        ],
    ),
    // A floodlight mast: a lattice of four legs, a bank of dead lamps on top facing +z. 30 m.
    Module(
        name: "floodlight",
        parts: [
            Mirror2(axis: X, at: 0.0, parts: [
                Mirror2(axis: Z, at: 0.0, parts: [
                    Box(at: (0.5, 0.0, 0.5), size: (0.3, 28.0, 0.3), mat: Metal),
