    Module(
        name: "gallery_bay",
        parts: [
            Box(at: (0.0, -0.5, -10.0), size: (8.0, 0.5, 10.0), mat: Tile),
            Box(at: (0.0, 0.0, -0.1), size: (8.0, 1.1, 0.06), mat: Glass),
            Box(at: (0.0, 1.1, -0.15), size: (8.0, 0.08, 0.15), mat: Metal),
            Box(at: (-0.4, -0.5, -0.8), size: (0.8, 6.0, 0.8), mat: Concrete),
            Box(at: (0.6, 0.0, -10.0), size: (6.8, 4.0, 0.15), mat: Glass),
            Box(at: (0.4, 4.0, -10.0), size: (7.2, 1.0, 0.4), mat: Accent),
            Slot(at: (4.0, 0.0, -5.0), rate: Props, pick: [Some("bench"), Some("planter"), Some("cardboard_box"),
                None, None]),
