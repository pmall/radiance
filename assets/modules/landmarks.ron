// Landmarks (milestone 10, pass 7): the pieces of the places that are not housing and that one
// remembers: the old stone city of the depths (a temple, tram lines), a station with its train
// shed and clock tower, a stadium, a mall around its atrium, a parking garage, the machines'
// works in the canopy. Each stands on its origin, its front toward +z.
[
    // A temple of the old city: a stepped base 24 x 16 m, eight columns in front of the cella, a
    // pediment stepped like pixels. Centered on its origin, its steps toward +z.
    Module(
        name: "temple",
        parts: [
            Box(at: (-13.0, 0.0, -9.0), size: (26.0, 0.6, 18.0), mat: StoneDark),
            Box(at: (-12.0, 0.6, -8.0), size: (24.0, 0.6, 16.0), mat: Stone),
            Box(at: (-11.0, 1.2, -7.0), size: (22.0, 0.6, 14.0), mat: Stone),
            Box(at: (-4.0, 0.0, 9.0), size: (8.0, 0.4, 1.2), mat: StoneDark),
            Box(at: (-9.0, 1.8, -6.5), size: (18.0, 9.0, 9.0), mat: Stone),
            Box(at: (-1.5, 1.8, 2.45), size: (3.0, 5.0, 0.1), mat: Paint((40, 34, 30))),
            Repeat(from: (-9.5, 1.8, 5.5), step: (2.7, 0.0, 0.0), count: 8, parts: [
                Box(at: (-0.5, 0.0, -0.5), size: (1.0, 0.4, 1.0), mat: StoneDark),
                Box(at: (-0.35, 0.4, -0.35), size: (0.7, 8.2, 0.7), mat: Stone),
                Box(at: (-0.5, 8.6, -0.5), size: (1.0, 0.4, 1.0), mat: StoneDark),
            ]),
            Box(at: (-11.0, 10.8, -7.0), size: (22.0, 1.0, 14.0), mat: StoneDark),
            Box(at: (-10.0, 11.8, -7.0), size: (20.0, 1.0, 14.0), mat: Stone),
            Box(at: (-7.5, 12.8, -7.0), size: (15.0, 1.0, 14.0), mat: Stone),
            Box(at: (-5.0, 13.8, -7.0), size: (10.0, 1.0, 14.0), mat: Stone),
            Box(at: (-2.5, 14.8, -7.0), size: (5.0, 1.0, 14.0), mat: StoneDark),
        ],
    ),
    // 24 m of a tram line: two rails on their sleepers, toward +x from the origin, the track's
    // middle at z = 0.
    Module(
        name: "tram_rails",
        parts: [
            Box(at: (0.0, 0.0, -0.8), size: (24.0, 0.05, 0.1), mat: Metal),
            Box(at: (0.0, 0.0, 0.7), size: (24.0, 0.05, 0.1), mat: Metal),
            Repeat(from: (0.4, 0.0, -1.2), step: (1.2, 0.0, 0.0), count: 20, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.3, 0.02, 2.4), mat: Wood),
            ]),
        ],
    ),
    // A tram pole with its arm over the tracks toward +z, and 24 m of overhead wire along +x.
    Module(
        name: "tram_pole",
        parts: [
            Box(at: (-0.15, 0.0, -0.15), size: (0.3, 7.0, 0.3), mat: Metal),
            Box(at: (-0.1, 6.6, 0.0), size: (0.2, 0.15, 5.0), mat: Metal),
            Box(at: (0.0, 6.2, 2.98), size: (24.0, 0.04, 0.04), mat: Metal),
            Box(at: (0.0, 6.2, 4.98), size: (24.0, 0.04, 0.04), mat: Metal),
        ],
    ),
    // A clock tower, 6 m square and 30 m tall: a brick shaft, a clock face on each side stopped at
    // ten past ten, a stepped stone cap.
    Module(
        name: "clock_tower",
        parts: [
            Box(at: (-3.5, 0.0, -3.5), size: (7.0, 1.0, 7.0), mat: StoneDark),
            Box(at: (-3.0, 1.0, -3.0), size: (6.0, 21.0, 6.0), mat: Brick),
            Box(at: (-3.3, 22.0, -3.3), size: (6.6, 0.5, 6.6), mat: Stone),
            Box(at: (-3.0, 22.5, -3.0), size: (6.0, 4.5, 6.0), mat: Stone),
            Mirror4(center: (0.0, 0.0), parts: [
                Box(at: (-1.8, 23.0, 3.0), size: (3.6, 3.6, 0.1), mat: Paint((222, 214, 190))),
                Box(at: (-0.08, 24.8, 3.1), size: (0.16, 1.4, 0.05), mat: Paint((30, 30, 30))),
                Box(at: (-1.1, 24.8, 3.1), size: (1.1, 0.16, 0.05), mat: Paint((30, 30, 30))),
