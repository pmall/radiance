    // A scoreboard on two legs, its screen dark, 16 x 7 m, facing +z.
    Module(
        name: "scoreboard",
        parts: [
            Box(at: (-6.0, 0.0, -0.6), size: (0.8, 10.0, 0.8), mat: Metal),
            Box(at: (5.2, 0.0, -0.6), size: (0.8, 10.0, 0.8), mat: Metal),
