    Module(
        name: "garage_bay",
        parts: [
            Box(at: (0.0, 3.1, 0.0), size: (8.0, 0.4, 40.0), mat: Concrete),
            Box(at: (-0.3, 0.0, 0.0), size: (0.6, 3.1, 0.6), mat: Concrete),
            Box(at: (-0.3, 0.0, 19.7), size: (0.6, 3.1, 0.6), mat: Concrete),
            Box(at: (-0.3, 0.0, 39.4), size: (0.6, 3.1, 0.6), mat: Concrete),
            Box(at: (0.0, 3.5, 0.0), size: (8.0, 1.0, 0.25), mat: Concrete),
            Box(at: (0.0, 3.5, 39.75), size: (8.0, 1.0, 0.25), mat: Concrete),
            Box(at: (0.0, 3.6, 39.95), size: (8.0, 0.3, 0.06), mat: Accent),
        ],
    ),
    // A garage ramp up one story (3.5 m) toward +x, 4 m wide: steps of 0.25 m every 0.8 m.
    Module(
        name: "garage_ramp",
        parts: [
            Repeat(from: (0.0, 0.0, 0.0), step: (0.8, 0.25, 0.0), count: 14, parts: [
