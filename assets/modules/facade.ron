// Facade units of the towers (docs/chunks.md, "Towers"), placed by `world/facade.rs` on the
// stories next to the decks, where they are seen up close; the shader paints the rest. Each stands
// on its bay: origin at the middle of the bay, on the window's sill (1 m above the story's floor),
// the wall at z = 0 and the street toward +z. The painted window behind is 1.75 m wide and
// 2.1 m high.
[
    // What a window has in front of it, if anything.
    Module(
        name: "facade_unit",
        parts: [
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("ac_unit"), Some("facade_cage"), Some("laundry"),
                Some("facade_balcony"), Some("facade_ac_cage"), None, None, None],
                accents: [(176, 52, 44), (60, 120, 150), (220, 180, 60), (120, 150, 90), (200, 200, 190)]),
        ],
    ),
    // A burglar cage over the window, sticking out to hold pots and junk.
    Module(
        name: "facade_cage",
        parts: [
            Box(at: (-1.1, -0.05, 0.0), size: (2.2, 0.08, 0.5), mat: Rust),
            Box(at: (-1.1, 2.3, 0.0), size: (2.2, 0.08, 0.5), mat: Rust),
            Repeat(from: (-0.9, -0.05, 0.44), step: (0.3, 0.0, 0.0), count: 7, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.05, 2.4, 0.05), mat: Metal),
            ]),
            Box(at: (-1.1, -0.05, 0.0), size: (0.05, 2.4, 0.5), mat: Metal),
            Box(at: (1.05, -0.05, 0.0), size: (0.05, 2.4, 0.5), mat: Metal),
            Slot(at: (0.6, 0.03, 0.25), pick: [Some("clay_pot"), Some("cardboard_box"), None, None]),
        ],
    ),
    // An air conditioner, and a cage around it.
    Module(
        name: "facade_ac_cage",
        parts: [
            Module(name: "ac_unit"),
            Box(at: (-0.5, -0.82, 0.0), size: (1.0, 0.06, 0.6), mat: Rust),
            Box(at: (-0.5, -0.18, 0.0), size: (1.0, 0.06, 0.6), mat: Rust),
            Repeat(from: (-0.5, -0.82, 0.55), step: (0.2, 0.0, 0.0), count: 6, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.04, 0.7, 0.04), mat: Rust),
            ]),
        ],
    ),
    // A balcony: a slab under the window, a railing, laundry or pots on it.
    Module(
        name: "facade_balcony",
        parts: [
            Box(at: (-1.6, -0.2, 0.0), size: (3.2, 0.2, 1.1), mat: Concrete),
            Box(at: (-1.6, 0.0, 1.02), size: (3.2, 1.0, 0.08), mat: Accent),
            Box(at: (-1.6, 0.0, 0.0), size: (0.08, 1.0, 1.1), mat: Accent),
            Box(at: (1.52, 0.0, 0.0), size: (0.08, 1.0, 1.1), mat: Accent),
            Box(at: (-1.6, 1.0, 1.0), size: (3.2, 0.06, 0.12), mat: Metal),
            Slot(at: (0.0, 0.0, 0.0), pick: [Some("laundry"), Some("balcony_pots"), None]),
        ],
    ),
    // A shop's front on the street story: an awning over the shutter in the accent color, a sign
    // box sticking out now and then. Origin at the middle of the bay, on the story's floor.
    Module(
        name: "facade_shop",
        parts: [
            Repeat(from: (-1.8, 2.6, 0.0), step: (0.8, 0.0, 0.0), count: 5, parts: [
                Box(at: (0.0, 0.0, 0.0), size: (0.4, 0.1, 1.3), mat: Accent),
                Box(at: (0.4, 0.0, 0.0), size: (0.4, 0.1, 1.3), mat: Paint((222, 210, 180))),
            ]),
            Box(at: (-1.8, 2.2, 1.25), size: (3.6, 0.4, 0.06), mat: Accent),
            Slot(at: (1.6, 3.0, 0.0), pick: [Some("sign_box"), None, None]),
        ],
    ),
    Module(
        name: "facade_awningless",
        parts: [
            Slot(at: (1.6, 3.0, 0.0), pick: [Some("sign_box"), None]),
        ],
    ),
    // An unlit sign box on a bracket, its face toward the street on both sides.
    Module(
        name: "sign_box",
        parts: [
            Box(at: (-0.03, 0.5, 0.0), size: (0.06, 0.06, 0.4), mat: Metal),
            Box(at: (-0.1, -0.2, 0.4), size: (0.2, 1.2, 0.9), mat: Accent),
            Box(at: (-0.11, 0.0, 0.5), size: (0.22, 0.8, 0.7), mat: Paint((226, 216, 190))),
        ],
    ),
]
